{
  "ConnectionStrings": {
    "SqlDefault": ""
  },
  "AllowedHosts": "*",
  "IdentitySettings": {
    "Audience": "identity_api",
    "EncryptionKey": null,
    "SigningCertificateThumbprint": null,
    "DisableDefaultValidationConfiguration": true
  },
  "QueryParametersSettings": {
    "MaxLimit": 100
  },
  "InternalErrorMiddlewareSettings": {
    "IsEnabled": true,
    "MaxBodyLengthInLog": 1024
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "restrictedToMinimumLevel": "Warning",
                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "logs/api.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": "7",
                "shared": true
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "Todo.Api"
    }
  }
}
